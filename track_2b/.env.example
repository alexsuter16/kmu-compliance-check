# Copy to .env and fill in. .env is never committed and never goes into the Docker image.

# Required (variable names set by Hack Apertus): an OpenAI-compatible Apertus 1.5 endpoint.
# Public AI: https://api.publicai.co/v1 · CSCS: https://api.swissai.svc.cscs.ch/v1 · local: http://127.0.0.1:8080/v1
LLM_NAME=swiss-ai/apertus-v1.5-8b
LLM_BASE_URL=https://api.publicai.co/v1
LLM_API_KEY=

# Optional, development only: a comparison model (python src/evaluate.py --provider litellm)
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=

# Optional: embedding model for the retrieval experiment (make search); runs offline, no key
EMBEDDING_MODEL=intfloat/multilingual-e5-small
